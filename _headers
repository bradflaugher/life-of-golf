# Cache control and security headers for Cloudflare Pages (lifeofgolf.win).
#
# Cloudflare Pages applies EVERY rule that matches a path, and comma-joins
# duplicate headers instead of overriding them. So the catch-all below must
# not set Cache-Control. Each path below matches at most one Cache-Control rule.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()

# App code and styles — revalidate via ETag so deploys take effect immediately.
/src/*.js
  Cache-Control: public, max-age=0, must-revalidate
/src/*.css
  Cache-Control: public, max-age=0, must-revalidate

# CaddieNet-v1 edge model weights — revalidate via ETag so updated models take effect cleanly.
/models/*
  Cache-Control: public, max-age=3600, must-revalidate

# Self-hosted WOFF2 fonts & vendored Three.js
/src/fonts/*
  Cache-Control: public, max-age=2592000, immutable
/vendor/*
  Cache-Control: public, max-age=2592000, immutable

# Static visual assets and install metadata
/*.svg
  Cache-Control: public, max-age=604800
/site.webmanifest
  Cache-Control: public, max-age=604800
